{
  "name": "bonesai",
  "productName": "BonesAI",
  "version": "2.7.2",
  "description": "Local-first macOS desktop tool for document summarisation and research. Runs Qwen2.5-7B on-device via llamafile.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac --x64 --dir",
    "dist": "electron-builder --mac --x64"
  },
  "author": "Winston Green",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^24.13.3",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.winstongreen.bonesai",
    "productName": "BonesAI",
    "copyright": "Copyright © 2026 Winston Green",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "vendor/llama-cpp",
        "to": "llama-cpp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "minimumSystemVersion": "11.0.0",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
